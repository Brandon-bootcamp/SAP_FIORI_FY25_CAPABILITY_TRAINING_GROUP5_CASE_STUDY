<mvc:View controllerName="casestudy.controller.detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <content>
      <VBox width="100%" direction="Column" id="vbox1">
        <items>
          <sap.ui.layout.form:SimpleForm
            xmlns:sap.ui.layout.form="sap.ui.layout.form"
            xmlns:sap.ui.core="sap.ui.core" editable="true" layout="ResponsiveGridLayout" id="form0">
            <sap.ui.layout.form:content>
              <sap.ui.core:Title text="Order Detail" id="title1"/>
              <Label text="Label 1" id="label0"/>
              <Input width="100%" id="input0"/>
              <Input width="100%" id="input1"/>
              <Label text="Label 2" id="label1"/>
              <Input width="100%" id="input2"/>
            </sap.ui.layout.form:content>
          </sap.ui.layout.form:SimpleForm>
        </items>
        <Table noDataText="Drop column list items here and columns in the area above" id="table0">
          <items>
            <ColumnListItem type="Active" id="item0">
              <cells>
                <Text text="Row 1 Cell 1" id="text3"/>
                <Text text="Row 1 Cell 2" id="text4"/>
                <Text text="Row 1 Cell 3" id="text5"/>
              </cells>
            </ColumnListItem>
          </items>
          <columns>
            <Column id="column0">
              <header>
                <Label text="Header 1" id="label0_1755501979710"/>
              </header>
            </Column>
            <Column id="column1">
              <header>
                <Label text="Header 2" id="label1_1755501979710"/>
              </header>
            </Column>
            <Column id="column2">
              <header>
                <Label text="Header 3" id="label2"/>
              </header>
            </Column>
          </columns>
        </Table>

         <HBox id="buttonBox" justifyContent="End" class="sapUiSmallMarginTop">
            <Button id="editButton" text="Edit" type="Emphasized" press="onEdit"/>
            <Button id="cancelButton" text="Cancel" type="Reject" press="onCancel"/>
        </HBox>
      </VBox>
    </content>
  </Page>
</mvc:View>