<core:FragmentDefinition xmlns:form="sap.ui.layout.form" xmlns:cards="sap.f.cards" xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="idProductDialog" title="Enter Quantity">

        <form:SimpleForm id="sformQuantity">
            <Label id="lblProductSelected"  required="true" text="{i18n>txtQuantity}"/>
            <Input id="inpQuantity" placeholder="Enter quantity..." type="Number" />
        </form:SimpleForm>

        <beginButton>
            <Button id="idButtonConfirmDialog" text="{i18n>btnConfirm}" type="Emphasized" press="onPressConfirmCreateOrder"/>
        </beginButton>

        <endButton>
            <Button id="idButtonCanceldialog" text="{i18n>btnCancel}" type="Reject" press="onCloseFragment" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>

