<core:FragmentDefinition xmlns:form="sap.ui.layout.form" xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog id="CreateOrderDialog"
        noDataText="No Product Found"
        title="{i18n>ttlSelectProduct}"
        search=".onSearchProduct"
        searchPlaceholder="Search Product..."
        confirm=".onValueHelpProductName"
        items="{
            path: '/Products'
        }">   
        <CustomListItem id="CustomListItem">
            <HBox justifyContent="SpaceBetween" id="hbox" class="sapUiSmallMarginTopBottom sapUiSmallMarginBeginEnd">
                <VBox id="vbox">
                    <Title id="ttlProductNameFrag" text="{ProductName}" />
                    <HBox id="vboxPrice">
                        <Text id="txtPrice" text="{i18n>txtPrice}" class="sapUiTinyMarginEnd"/>
                        <Text id="txtProductPrice" text="{PricePerQuantity}" />
                    </HBox>
                    <Text id="txtPricePerQuantityFrag" text="{ProductID}" visible="false" />
                    <Text id="txtDeliveringPlantDescription" text="{DeliveringPlantDescription}" visible="false" />
                    <Text id="txtDeliveringPlantCodeFrag" text="{DeliveringPlantCode}" visible="false" />
                </VBox>
            </HBox>
        </CustomListItem>
    </SelectDialog>
</core:FragmentDefinition>