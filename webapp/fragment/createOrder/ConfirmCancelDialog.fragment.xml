<core:FragmentDefinition xmlns:form="sap.ui.layout.form" xmlns:cards="sap.f.cards" xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="idConfirmCancel" title="Confirmation">

        <form:SimpleForm id="sformConfirmCancel">
            <Text id="txtConfirmCancel" text="Are you sure you want to cancel the changes done in the page?" />
        </form:SimpleForm>

        <beginButton>
            <Button id="idButtonConfirmCancelDialog" text="Confirm" type="Emphasized" press="onConfirmCancelOrder"/>
        </beginButton>

        <endButton>
            <Button id="idButtonCancelCanceldialog" text="Cancel" type="Reject" press="onCloseFragment" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>