<core:FragmentDefinition xmlns:form="sap.ui.layout.form" xmlns:cards="sap.f.cards" xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="idConfirm" title="Confirmation">

        <form:SimpleForm id="sformConfirm">
            <Text id="txtConfirmation" text="Are you sure you want to delete items?" />
        </form:SimpleForm>

        <beginButton>
            <Button id="idButtonConfirmOrderDialog" text="Confirm" type="Emphasized" press="onConfirmDeleteOrder"/>
        </beginButton>

        <endButton>
            <Button id="idButtonCancelOrderdialog" text="Cancel" type="Reject" press="onCloseFragment" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>