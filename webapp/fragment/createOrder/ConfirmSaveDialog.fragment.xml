<core:FragmentDefinition xmlns:form="sap.ui.layout.form" xmlns:cards="sap.f.cards" xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="idConfirmSave" title="Confirmation">

        <form:SimpleForm id="sformConfirmSave">
            <Text id="txtConfirmSave" text="Are you sure you want save order?" />
        </form:SimpleForm>

        <beginButton>
            <Button id="idButtonConfirmSaveDialog" text="Confirm" type="Emphasized" press="onConfirmSaveOrder"/>
        </beginButton>

        <endButton>
            <Button id="idButtonCancelSavedialog" text="Cancel" type="Reject" press="onCloseFragment" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>