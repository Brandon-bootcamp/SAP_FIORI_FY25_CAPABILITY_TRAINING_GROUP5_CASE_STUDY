<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog id="SelectDialogReceivingPlant"
        noDataText="No Receiving Plant Found"
        title="{i18n>ttlReceivingPlant}"
        search=".onSearchReceivingPlant"
        selectionChange="onSelectProduct"
        searchPlaceholder="Search Receiving Plant..."
        confirm=".onValueHelpReceivingPlantDialogClose"
        cancel=".onValueHelpReceivingPlantDialogClose"
        items="{
            path: '/ReceivingPlants'
        }">

        <CustomListItem id="CustomListItemReceivingPlant">
            <HBox justifyContent="SpaceBetween" id="hboxReceivingPlant" class="sapUiSmallMarginTopBottom sapUiSmallMarginBeginEnd">
                <VBox id="vboxReceivingPlant">
                    <Text id="ttlReceivingPlantDesc" text="{ReceivingPlantDescription}" />
                    <HBox id="hboxDevPlant">
                        <Title id="txtReceivingPlantCode" text="{ReceivingPlantCode}" visible="false" />
                    </HBox>
                </VBox>
            </HBox>
        </CustomListItem>
    </SelectDialog>

</core:FragmentDefinition>