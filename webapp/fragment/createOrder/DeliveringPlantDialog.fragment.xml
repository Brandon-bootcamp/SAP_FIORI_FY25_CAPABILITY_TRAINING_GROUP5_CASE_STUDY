<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog id="SelectDialogDeliveringPlant"
        noDataText="No Delivering Plant Found"
        title="{i18n>ttlDeliveringPlant}"
        search=".onSearchDeliveringPlant"
        searchPlaceholder="Search Delivering Plant..."
        confirm=".onValueHelpDeliveringPlantDialogClose"
        cancel=".onValueHelpDeliveringPlantDialogClose"
        items="{
            path: '/Products'
        }">
        <CustomListItem id="CustomListItemDeliveringPlant">
            <HBox justifyContent="SpaceBetween" id="hboxDeliveringPlant" class="sapUiSmallMarginTopBottom sapUiSmallMarginBeginEnd">
                <VBox id="vboxDeliveringPlant">
                    <Text id="ttlDeliveringPlantDescription" text="{DeliveringPlantDescription}" />
                    <HBox id="hboxRevPlant">
                        <Title id="txtDeliveringPlantCode" text="{DeliveringPlantCode}" visible="false" />
                    </HBox>
                </VBox>
            </HBox>
        </CustomListItem>
    </SelectDialog>

</core:FragmentDefinition>