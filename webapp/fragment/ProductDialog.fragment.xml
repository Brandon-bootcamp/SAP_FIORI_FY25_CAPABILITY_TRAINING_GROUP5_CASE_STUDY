<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:controller="casestudy.controller.EditPage">
    <Dialog id="_IDGenDialog1" title="Add Product" draggable="true" resizable="true">
        <VBox id="_IDGenVBox">
            <Label id="_IDGenLabel" text="Select Product" />
                <Select
                    id="productSelect"
                    selectedKey="{dialog>/selectedProductId}"
                    items="{dialog>/availableProducts}">
                    <core:Item id="_IDGenItem" key="{dialog>id}" text="{dialog>name}" />
                </Select>
            <Label id="_IDGenLabel1" text="Quantity" />
            <Input id="_IDGenInput" value="{dialog>/quantity}" type="Number" />
        </VBox>
        <endButton>
           <Button id="_IDGenButton" text="Add" press="onConfirmAddProduct"  />
        </endButton>
        <beginButton>
            <Button id="_IDGenButton1" text="Cancel" press="onCancelAddProduct" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>