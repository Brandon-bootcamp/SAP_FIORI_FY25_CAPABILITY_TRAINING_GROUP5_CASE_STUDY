<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="_IDGenDialog1" title="Add Product" draggable="true" resizable="true">
        <VBox id="_IDGenVBox" class="sapUiSmallMargin">
            <Label id="_IDGenLabel1" text="Select Product" />
            <Select
                id="productSelect"
                selectedKey="{dialog>/selectedProductId}"
                items="{dialog>/availableProducts}">
                <core:Item id="_IDGenItem" key="{dialog>ProductID}" text="{dialog>ProductName}" />
            </Select>

            <Label id="_IDGenLabel6" text="Quantity" class="sapUiSmallMarginTop" />
            <Input id="_IDGenInput" value="{dialog>/quantity}" type="Number" />
        </VBox>

        <endButton>
            <Button id="_IDGenButton" text="Add" press="onConfirmAddProduct" />
        </endButton>
        <beginButton>
            <Button id="_IDGenButton1" text="Cancel" press="onCancelAddProduct" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>