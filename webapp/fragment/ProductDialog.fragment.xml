<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:controller="com.ordermanagement.ordermanagement.fragment.ProductDialog">
    <Dialog id="_IDGenDialog1" title="Add Product" draggable="true" resizable="true" contentWidth="400px">
       <content>
        <VBox id="_IDGenVBox" class="sapUiSmallMargin">
            <Label id="_IDGenLabel" text="Select Product" labelFor="productSelect"/>
            <ComboBox id="_IDGenComboBox1" selectedKey="{dialog>/selectedProductId}"
                      items="{dialog>/availableProducts}">
                <core:Item id="_IDGenItem" key="{dialog>ProductID}" text="{dialog>ProductName}" />
            </ComboBox>

            <Label id="_IDGenLabel1" text="Quantity" labelFor="quantityInput" />
            <Input id="quantityInput"
                   value="{dialog>/quantity}"
                   type="Number"
                   placeholder="Enter quantity"
                   required="true"/>
        </VBox>
        </content>
        <beginButton>
            <Button id="_IDGenButton" text="Add" type="Emphasized" press="onConfirmAddProduct"/>
        </beginButton>
        <endButton>
            <Button id="_IDGenButton1" text="Cancel" press="onCancelAddProduct"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>