<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:controller="com.ordermanagement.ordermanagement.fragment.ProductDialog">
    <Dialog id="_IDGenDialog1" title="Add Product" draggable="true" resizable="true" contentWidth="400px" contentHeight="auto">
        <VBox id="_IDGenVBox" class ="sapUiSmallMargin">
            <Label id="_IDGenLabel" text="Select Product"  labelFor="productSelect"/>
             <Select id="productSelect" selectedKey="{dialog>/selectedProductId}"  items="{path: 'dialog>/availableProducts', sorter: {path: 'name'}}">
                <core:Item id="_IDGenItem" key="{dialog>id}" text="{dialog>name}" />
            </Select>
            <Label id="_IDGenLabel1" text="Quantity" labelFor="quantityInput"/>
            <Input id="_IDGenInput" value="{dialog>/quantity}" type="Number" placeholder="Enter quantity" required="true" liveChange="onQuantityChange"/>
        </VBox>
        <endButton>
           <Button id="_IDGenButton" text="Add" press="onConfirmAddProduct"  />
        </endButton>
        <beginButton>
            <Button id="_IDGenButton1" text="Cancel"  press="onCancelAddProduct" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>