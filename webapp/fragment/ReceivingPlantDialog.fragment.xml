<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog id="SelectDialogReceivingPlant"
        noDataText="No Receiving Plant Found"
        title="Receiving Plant"
        search=".onSearchReceivingPlant"
        selectionChange="onSelectProduct"
        searchPlaceholder="Search Receiving Plant..."
        confirm=".onValueHelpReceivingPlantDialogClose"
        cancel=".onValueHelpReceivingPlantDialogClose"
        items="{
            path: '/Orders'
        }">
        <StandardListItem id="StandardListReceivingPlant" 
            title="{ReceivingPlantDescription}"
            iconDensityAware="false"
            iconInset="false"
            type="Active" />
    </SelectDialog>

</core:FragmentDefinition>