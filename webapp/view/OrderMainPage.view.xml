<mvc:View
  controllerName="com.ordermanagement.ordermanagement.controller.OrderMainPage"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
<Page id="orderPage" title="{i18n>OrderMainPageTitle}" floatingFooter="true" xmlns="sap.m" xmlns:core="sap.ui.core">
  <content>

    <!-- Filter Panel -->
    <Panel id="filterPanel" headerText="" expandable="false" class="sapUiMediumMarginBottom">
      <VBox id="_IDGenVBox1" justifyContent="Center" alignItems="Center">
        <HBox id="_IDGenHBox" justifyContent="Center" alignItems="Center">

          <!-- Order Number -->
          <VBox id="_IDGenVBox2" class="sapUiSmallMarginEnd">
            <Label id="_IDGenLabel2" text="{i18n>orderNumberLabel}" labelFor="orderNumberInput"/>
            <Input
              id="orderNumberInput"
              placeholder="{i18n>orderNumberPlaceholder}"
              width="220px"
              type="Text"
              liveChange="onOrderNumberLiveChange"/>
          </VBox>

          <!-- Creation Date -->
          <VBox id="_IDGenVBox3" class="sapUiSmallMarginEnd">
            <Label id="_IDGenLabel3" text="{i18n>creationDateLabel}" labelFor="creationDateInput"/>
            <DatePicker
              id="creationDateInput"
              placeholder="{i18n>creationDatePlaceholder}"
              width="220px"
              displayFormat="yyyy-MM-dd"
              valueFormat="yyyy-MM-dd"
              liveChange="onCreationDateLiveChange"/>
          </VBox>

          <!-- Status -->
          <VBox id="_IDGenVBox4" class="sapUiSmallMarginEnd">
            <Label id="_IDGenLabel4" text="{i18n>statusLabel}" labelFor="statusMultiCombo"/>
            <MultiComboBox id="statusMultiCombo" width="220px">
              <items>
                <core:Item id="_IDGenItem1" key="Created" text="{i18n>statusCreated}"/>
                <core:Item id="_IDGenItem2" key="Released" text="{i18n>statusReleased}"/>
                <core:Item id="_IDGenItem3" key="Partially Completed" text="{i18n>statusPartiallyCompleted}"/>
                <core:Item id="_IDGenItem4" key="Delivered" text="{i18n>statusDelivered}"/>
              </items>
            </MultiComboBox>
          </VBox>

          <!-- Action Buttons -->
          <VBox id="_IDGenVBox5">
            <Label id="_IDGenLabel5" text=" "/>
            <HBox id="_IDGenHBox1">
              <Button id="_IDGenButton2" text="{i18n>goButton}" press="onFilter"/>
              <Button id="_IDGenButton3" text="{i18n>clearButton}" press="onClear"/>
            </HBox>
          </VBox>

        </HBox>
      </VBox>
    </Panel>

    <!-- Orders Panel -->
    <Panel id="_IDGenPanel" expandable="false">
      <VBox id="_IDGenVBox6">

        <!-- Toolbar -->
        <Toolbar id="_IDGenToolbar">
          <Title id="_IDGenTitle" text="{i18n>ordersTitle}"/>
          <ToolbarSpacer id="_IDGenToolbarSpacer"/>
          <Button id="addOrderButton" icon="sap-icon://add" tooltip="{i18n>addOrderTooltip}" press="onPressCreateOrder"/>
          <Button id="deleteOrderButton" icon="sap-icon://delete" tooltip="{i18n>deleteOrderTooltip}" press="onDeletePress"/>
        </Toolbar>

        <Table id="ordersTable" items="{local>/Orders}" mode="MultiSelect">
          <columns>
            <Column id="_IDGenColumn1"><Text id="_IDGenText" text="{i18n>orderNumberLabel}"/></Column>
            <Column id="_IDGenColumn2"><Text id="_IDGenText1" text="{i18n>creationDateLabel}"/></Column>
            <Column id="_IDGenColumn3"><Text id="_IDGenText2" text="Receiving Plant"/></Column>
            <Column id="_IDGenColumn4"><Text id="_IDGenText3" text="Delivering Plant"/></Column>
            <Column id="_IDGenColumn5"><Text id="_IDGenText4" text="{i18n>statusLabel}"/></Column>
          </columns>
          <items>
            <ColumnListItem id="_IDGenColumnListItem" type="Active" press="onOrderSelect">
              <cells>
                <Text id="_IDGenText5" text="{local>OrderNumber}"/>
                <Text id="_IDGenText6" text="{local>CreationDate}"/>
                <Text id="_IDGenText7" text="{local>ReceivingPlantCode} - {local>ReceivingPlantDescription}"/>
                <Text id="_IDGenText8" text="{local>Products/results/0/DeliveringPlantCode} - {local>Products/results/0/DeliveringPlantDescription}"/>
                <ObjectStatus id="_IDGenObjectStatus"
                  text="{local>Status}"
                  state="{= 
                    ${Status} === 'Created' ? 'None' : 
                    ${Status} === 'Released' ? 'Warning' : 
                    ${Status} === 'Partially Completed' ? 'Information' : 
                    ${Status} === 'Delivered' ? 'Success' : 'None'
                  }"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

      </VBox>
    </Panel>

  </content>
</Page>
</mvc:View>
