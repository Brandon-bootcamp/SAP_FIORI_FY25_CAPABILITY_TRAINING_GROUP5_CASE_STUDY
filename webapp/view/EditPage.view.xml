<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:m="sap.m" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" controllerName="editpage.controller.EditPage">
<Page id="page3" floatingFooter="true" title="{i18n>title}">
        <content>

            <!-- Order Details Panel -->
            <Panel id="panel0" width="auto" expandable="false" class="sapUiResponsiveMargin" expanded="true">
                <headerToolbar>
                    <Toolbar id="toolbar1">
                        <Title id="_IDGenTitle1" text="Order Details"/>
                    </Toolbar>
                </headerToolbar>
            
                   <HBox id="fb" justifyContent="Center" >
                        <sap.ui.layout.form:SimpleForm xmlns:sap.ui.layout.form="sap.ui.layout.form" xmlns:sap.ui.core="sap.ui.core" editable="true" layout="ColumnLayout" columnsL="1" columnsM="1" columnsXL="1" id="formOrderDetails" width="100%" >
                        <sap.ui.layout.form:content>
                            <Label id="orderNumber" text="Order Number"/>
                            <Input id="inp_ordernumber" value="{OrderNumber}" editable="false" width="50%"/>

                            <Label id="createdOn" text="Created On"/>
                            <Input id="inp_createdOn" value="{CreatedOn}" editable="false" width="50%"/>

                            <Label id="receivingplant" text="Receiving Plant"/>
                            <Input id="inp_receivingplant" value="{ReceivingPlant}" editable="false" width="50%"/>

                            <Label id="deliveringplant" text="Delivering Plant"/>
                            <Input id="inp_deliveringplant" value="{DeliveringPlant}" editable="false" width="50%"/>

                            <Label id="idstatus" text="Status"/>
                            <Select id="idSelStatus" forceSelection="false" change="onChangeStatus" width="50%">
                                <items>
                                    <core:Item id="idItmCreated" text="Created" key="Created"/>
                                </items>
                            </Select>
                        </sap.ui.layout.form:content>
                        </sap.ui.layout.form:SimpleForm>
                    </HBox>
            </Panel>

            <!-- Product Table Panel -->
            <Panel id="panel0_1755497504020" width="auto" expandable="false" class="sapUiResponsiveMargin" expanded="true">
                <headerToolbar>
                    <Toolbar id="toolbar1_1755497504020">
                        <Title id="_IDGenTitle2" text="Product(0)"/>
                        <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                        <Button id="_IDGenButton" icon="sap-icon://add" press="onAddProduct"/>
                        <Button id="_IDGenButton_copy" icon="sap-icon://delete" press="onDeleteProduct"/>
                    </Toolbar>
                </headerToolbar>

                <content>
                    <Table id="table0" items="{/products}" noDataText="Drop column list items here and columns in the area above">

                        <columns>
                            <Column id="column011">
                                <header>
                                    <CheckBox id="_IDGenCheckBox" text="Product Name"/>
                                </header>
                            </Column>
                            <Column id="column1">
                                <header>
                                    <Label id="label1_1755497526125" text="Quantity"/>
                                </header>
                            </Column>
                            <Column id="column2">
                                <header>
                                    <Label id="label2" text="Price Per Quantity"/>
                                </header>
                            </Column>
                            <Column id="column3">
                                <header>
                                    <Label id="label3" text="Total Price"/>
                                </header>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem id="item0" type="Active">
                                <cells>
                                    <Text id="text1" text="{ProductName}"/>
                                    <Text id="text2" text="{Quantity}"/>
                                    <Text id="text3" text="{PricePerQuantity}"/>
                                    <Text id="text4" text="{TotalPrice}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>

        </content>

        <!-- Footer Toolbar -->
        <footer>
            <OverflowToolbar id="_IDGenOverflowToolbar1">
                <ToolbarSpacer id="_IDGenToolbarSpacer1"/>
                <Button id="_IDGenButton1" type="Emphasized" text="Save" press="onSave"/>
                <Button id="_IDGenButton2" type="Reject" text="Cancel" press="onCancel"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>