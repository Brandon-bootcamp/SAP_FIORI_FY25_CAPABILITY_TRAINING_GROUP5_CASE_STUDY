<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:m="sap.m" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" controllerName="com.ordermanagement.ordermanagement.controller.EditPage">
    <Page id="EditPage" floatingFooter="true" title="{i18n>title}">
        <content>

            <!-- Order Details Panel -->
            <Panel id="orderDetailsPanel" width="auto" expandable="false" class="sapUiResponsiveMargin" expanded="true">
                <headerToolbar>
                    <Toolbar id="orderDetailsToolbar">
                        <Title id="orderDetailsTitle" text="Order Details"/>
                    </Toolbar>
                </headerToolbar>
                <HBox id="orderDetailsHBox" justifyContent="Center">
                    <f:SimpleForm id="orderDetailsForm" editable="true" layout="ColumnLayout" columnsL="1" columnsM="1" columnsXL="1" width="100%">
                        <f:content>
                            <Label id="lblOrderNumber" text="Order Number"/>
                            <Input id="inpOrderNumber" value="{OrderNumber}" editable="false" width="50%"/>

                            <Label id="lblCreatedOn" text="Created On"/>
                            <Input id="inpCreatedOn" value="{CreationDate}" editable="false" width="50%"/>

                            <Label id="lbl_ReceivingPlant" text="Receiving Plant"/>
                            <Input id="inp_ReceivingPlant" value="{ReceivingPlantCode} - {ReceivingPlantDescription}" editable="false" width="50%"/>

                            <Label id="lbl_DeliveringPlant" text="Delivering Plant"/>
                            <Input id="inp_DeliveringPlant" value="{DeliveringPlantCode} - {DeliveringPlantDescription}" editable="false" width="50%"/>

                            <Label id="lblStatus" text="Status"/>
                            <Select id="selStatus" forceSelection="false" change="onChangeStatus" width="50%" selectedKey="{Status}">
                                <items>
                                    <core:Item id="statusCreated" text="Created" key="Created"/>
                                    <core:Item id="statusReleased" text="Released" key="Released"/>
                                    <core:Item id="statusPartiallyCompleted" text="Partially Completed" key="Partially Completed"/>
                                    <core:Item id="statusDelivered" text="Delivered" key="Delivered"/>
                                </items>
                            </Select>
                        </f:content>
                    </f:SimpleForm>
                </HBox>
            </Panel>

            <!-- Product Table Panel -->
            <Panel id="productTablePanel" width="auto" expandable="false" class="sapUiResponsiveMargin" expanded="true">
                <headerToolbar>
                    <Toolbar id="productToolbar">
                        <Title id="productTitle" text="Product"/>
                        <ToolbarSpacer id="productToolbarSpacer"/>
                        <Button id="btnAddProduct" icon="sap-icon://add" press="onAddProduct"/>
                        <Button id="btnDeleteProduct" icon="sap-icon://delete" press="onDeleteProduct"/>
                    </Toolbar>
                </headerToolbar>

                <content>
                    <Table id="productTable" items="{Products}" noDataText="No data">
                        <columns>
                            <Column id="colCheckBox" width="5rem">
                                <header>
                                   <CheckBox id="cbColCheckBox" select="onSelectAllProducts"/>
                                </header>
                            </Column>
                            <Column id="colProductName">
                                <header>
                                    <Text id="lblProductName" text="Product Name"/>
                                </header>
                            </Column>
                            <Column id="colQuantity">
                                <header>
                                    <Label id="lbl_Quantity" text="Quantity"/>
                                </header>
                            </Column>
                            <Column id="colPricePerQuantity">
                                <header>
                                    <Label id="lblPricePerQuantity" text="Price Per Quantity"/>
                                </header>
                            </Column>
                            <Column id="col_TotalPrice">
                                <header>
                                    <Label id="lbl_TotalPrice" text="Total Price"/>
                                </header>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem id="_productListItem" type="Active">
                                <cells>
                                    <CheckBox id="chkSelectProduct" selected="{selected}" select="onSelectProduct"/>
                                    <Text id="txtProductName" text="{ProductName}"/>
                                    <Text id="_txtQuantity" text="{Quantity}"/>
                                    <Text id="_txtPricePerQuantity" text="{PricePerQuantity}"/>
                                    <Text id="_txtTotalPrice" text="{TotalPrice}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>
        </content>

        <!-- Footer Toolbar -->
        <footer>
            <OverflowToolbar id="_footerToolbar">
                <ToolbarSpacer id="footerToolbarSpacer"/>
                <Button id="_btnSave" type="Emphasized" text="Save" press="onSave"/>
                <Button id="_btnCancel" type="Reject" text="Cancel" press="onCancel"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>