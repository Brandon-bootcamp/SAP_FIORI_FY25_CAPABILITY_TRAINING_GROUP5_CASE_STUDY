<?xml version="1.0" encoding="utf-8" ?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
    <edmx:DataServices m:DataServiceVersion="2.0" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
        <Schema Namespace="OrderService" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
            <!-- Order Entity -->
            <EntityType Name="Order">
                <Key>
                    <PropertyRef Name="OrderNumber" />
                </Key>
                <Property Name="OrderNumber" Type="Edm.Int32" Nullable="false" />
                <Property Name="CreationDate" Type="Edm.DateTime" Nullable="false" />
                <Property Name="ReceivingPlantCode" Type="Edm.Int32" />
                <Property Name="ReceivingPlantDescription" Type="Edm.String" />
                <Property Name="Status" Type="Edm.String" />
                <NavigationProperty Name="Products" Relationship="OrderService.Order_Product" FromRole="Order" ToRole="Product" />
            </EntityType>

            <!-- Product Entity -->
            <EntityType Name="Product">
                <Key>
                    <PropertyRef Name="ProductID" />
                </Key>
                <Property Name="ProductID" Type="Edm.String" Nullable="false" />
                <Property Name="ProductName" Type="Edm.String" />
                <Property Name="Quantity" Type="Edm.Int32" />
                <Property Name="PricePerQuantity" Type="Edm.Decimal" />
                <Property Name="DeliveringPlantCode" Type="Edm.Int32" />
                <Property Name="DeliveringPlantDescription" Type="Edm.String" />
            </EntityType>

            <!-- Association between Order and Product -->
            <Association Name="Order_Product">
                <End Type="OrderService.Order" Role="Order" Multiplicity="1" />
                <End Type="OrderService.Product" Role="Product" Multiplicity="*" />
            </Association>

            <!-- Entity Sets -->
            <EntityContainer Name="OrderServiceEntities" m:IsDefaultEntityContainer="true">
                <EntitySet Name="Orders" EntityType="OrderService.Order" />
                <EntitySet Name="Products" EntityType="OrderService.Product" />
                <AssociationSet Name="Order_ProductSet" Association="OrderService.Order_Product">
                    <End Role="Order" EntitySet="Orders" />
                    <End Role="Product" EntitySet="Products" />
                </AssociationSet>
            </EntityContainer>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>